          },
          "uses": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "How often it may be redeemed"
          },
          "used": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "How often it has been"
          },
          "created": {
            "type": "integer",
            "x-index": true
          },
          "log_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "log",
            "x-qg-on-parent-delete": "setnull",
            "description": "The request that issued it"
          }
        },
        "required": ["hash", "purpose", "uses", "used", "created"]
