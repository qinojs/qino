{
  "properties": {
    "ticket": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "hash": {
            "type": "string",
            "maxLength": 43,
            "x-index": "unique",
            "description": "Keyed hash of the secret; the secret itself is never stored"
          },
          "purpose": {
            "type": "string",
            "maxLength": 64,
            "x-index": true,
            "description": "The registered kind, e.g. contact.sms"
          },
          "scope": {
            "type": "string",
            "maxLength": 191,
            "x-index": true,
            "description": "What the ticket is about — one open ticket per purpose and scope; null allows many"
          },
          "usr_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "usr",
            "x-qg-on-parent-delete": "cascade"
          },
          "data": {
            "type": "string",
            "description": "Payload as JSON, written when the ticket is issued and trusted when it is redeemed"
          },
          "expires": {
            "type": "integer",
            "x-index": true
          },
          "uses": {
            "type": "integer",
            "minimum": 0,
            "default": 1,
            "description": "Redemptions left"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Wrong guesses so far — only short codes can be guessed"
          },
          "sent": {
            "type": "integer",
            "description": "When the secret last went out — the resend limit reads this"
          },
          "created": {
            "type": "integer",
            "x-index": true
          }
        },
        "required": ["id", "hash", "purpose", "expires", "uses", "attempts", "created"]
      }
    }
  }
}
