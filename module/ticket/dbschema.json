{
  "properties": {
    "ticket": {
      "additionalProperties": {
        "properties": {
          "hash": {
            "type": "string",
            "maxLength": 43,
            "x-index": "primary",
            "description": "Keyed hash of the handle; the handle itself exists only in transit"
          },
          "purpose": {
            "type": "string",
            "maxLength": 64,
            "x-index": true,
            "description": "The registered kind, e.g. auth.resetPw"
          },
          "data": {
            "type": "string",
