{
  "properties": {
    "email_inbox": {
      "description": "Import cursor per server, account and mailbox",
      "additionalProperties": {
        "properties": {
          "id": { "type": "string", "maxLength": 64, "x-index": "primary" },
          "validity": { "type": "string", "maxLength": 32 },
          "uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "failed": { "type": "integer", "default": 0, "description": "Failed tries of the next mail" }
        },
        "required": ["id", "validity", "uid"]
      }
    },
    "email_receipt": {
      "description": "Hash of each imported mail's Message-ID, or of its source; outlives the journal entry",
      "additionalProperties": {
        "properties": {
          "id": { "type": "string", "maxLength": 64, "x-index": "primary" }
        },
        "required": ["id"]
      }
    }
  }
}
