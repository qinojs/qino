{
  "properties": {
    "message": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "channel": {
            "type": "string",
            "maxLength": 32,
            "x-index": true,
            "description": "Transport channel such as sms, telegram or webpush"
          },
          "direction": {
            "type": "string",
            "enum": ["in", "out"],
            "maxLength": 3,
            "x-index": true
          },
          "grp_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "grp",
            "x-qg-on-parent-delete": "setnull",
            "description": "Originating user group when the message targeted one"
          },
          "log_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "log"
          },
          "title": {
            "type": "string",
            "maxLength": 191,
            "description": "The message's own title, as every channel understands it"
          },
          "text": {
            "type": "string",
            "description": "The message's own text, as every channel understands it"
          },
          "format": {
            "type": "string",
            "maxLength": 8,
            "description": "What the text is: md, html, or plain text when empty"
          },
          "template": {
            "type": "string",
            "maxLength": 64,
            "description": "The frame the text was sent in; the journal keeps the message, not the frame"
          },
          "data": {
            "type": "string",
            "description": "Channel-native JSON payload and routing data"
          },
          "time": {
            "type": "integer",
            "x-index": true
          }
        },
        "required": ["id", "channel", "direction", "data", "time"]
      }
    },
    "message_template": {
      "additionalProperties": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "x-index": "primary",
            "description": "What a message asks for by name"
          },
          "channel": {
            "type": "string",
            "maxLength": 32,
            "x-index": "primary",
            "description": "The channel this variant is for — every channel says it its own way"
          },
          "main": {
            "type": "boolean",
            "description": "The one a message without a wish gets — one per channel, as with usr_contact"
          },
          "format": {
            "type": "string",
            "maxLength": 8,
            "description": "What the template text is: md, html, or plain text when empty"
          },
          "text": {
            "type": "string",
            "description": "The frame; {{content}} is the message, every other marker the recipient"
          }
        },
        "required": ["name", "channel"]
      }
    },
    "message_delivery": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "message_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "message",
            "x-qg-on-parent-delete": "cascade"
          },
          "usr_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "usr",
            "x-qg-on-parent-delete": "setnull",
            "description": "Only when the destination is a verified contact of that user"
          },
          "address": {
            "type": "string",
            "maxLength": 191,
            "x-index": true,
            "description": "Where it went: number, mail address, chat or endpoint hash"
          },
          "time": {
            "type": "integer",
            "x-index": true
          },
          "error": {
            "type": "string",
            "description": "Delivery error; null means the recipient was reached"
          }
        },
        "required": ["id", "message_id", "time"]
      }
    },
    "usr_contact_verification": {
      "additionalProperties": {
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 32,
            "x-index": "primary",
            "description": "The kind of address being claimed, as in usr_contact"
          },
          "address": {
            "type": "string",
            "maxLength": 254,
            "x-index": "primary",
            "description": "The contact being claimed — one open claim per user, address and channel"
          },
          "usr_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "usr",
            "x-qg-on-parent-delete": "cascade"
          },
          "hash": {
            "type": "string",
            "maxLength": 43,
            "description": "Keyed hash of the code; the code itself is never stored"
          },
          "expires": {
            "type": "integer",
            "x-index": true
          },
          "sent": {
            "type": "integer",
            "description": "When the last code went out — the resend limit reads this"
          },
          "created": {
            "type": "integer",
            "x-index": true
          }
        },
        "required": ["channel", "address", "usr_id", "hash", "expires", "created"]
      }
    }
  }
}
