{
  "properties": {
    "message": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "channel": {
            "type": "string",
            "maxLength": 32,
            "x-index": true,
            "description": "Transport channel such as sms, telegram or web_push"
          },
          "direction": {
            "type": "string",
            "enum": ["in", "out"],
            "maxLength": 3,
            "x-index": true
          },
          "grp_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "grp",
            "x-qg-on-parent-delete": "setnull",
            "description": "Originating user group when the message targeted one"
          },
          "log_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "log"
          },
          "data": {
            "type": "string",
            "description": "Channel-native JSON payload and routing data"
          },
          "time": {
            "type": "integer",
            "x-index": true
          }
        },
        "required": ["id", "channel", "direction", "data", "time"]
      }
    },
    "message_delivery": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "message_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "message",
            "x-qg-on-parent-delete": "cascade"
          },
          "usr_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "usr",
            "x-qg-on-parent-delete": "setnull",
            "description": "Only when the destination is a verified contact of that user"
          },
          "address": {
            "type": "string",
            "maxLength": 191,
            "x-index": true,
            "description": "Where it went: number, mail address, chat or endpoint hash"
          },
          "time": {
            "type": "integer",
            "x-index": true
          },
          "error": {
            "type": "string",
            "description": "Delivery error; null means the recipient was reached"
          }
        },
        "required": ["id", "message_id", "time"]
      }
    },
    "usr_contact_verification": {
      "additionalProperties": {
        "properties": {
          "channel": {
            "type": "string",
            "maxLength": 32,
            "x-index": "primary"
          },
          "address": {
            "type": "string",
            "maxLength": 191,
            "x-index": "primary",
            "description": "The contact being claimed — one open claim per address and channel"
          },
          "usr_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "usr",
            "x-qg-on-parent-delete": "cascade"
          },
          "hash": {
            "type": "string",
            "maxLength": 43,
            "description": "Keyed hash of the code; the code itself is never stored"
          },
          "expires": {
            "type": "integer",
            "x-index": true
          },
          "sent": {
            "type": "integer",
            "description": "When the last code went out — the resend limit reads this"
          },
          "created": {
            "type": "integer",
            "x-index": true
          }
        },
        "required": ["channel", "address", "usr_id", "hash", "expires", "created"]
      }
    }
  }
}
