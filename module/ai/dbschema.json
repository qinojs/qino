{
  "properties": {
    "ai_provider": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "name": {
            "type": "string",
            "maxLength": 191,
            "x-index": "unique",
            "description": "Also the name of its key in core.keys"
          },
          "type": {
            "type": "string",
            "maxLength": 64,
            "default": "openai",
            "description": "Adapter (aiAdapters)"
          },
          "endpoint": {
            "type": "string",
            "maxLength": 255
          },
          "timeout_ms": {
            "type": "integer",
            "default": 60000,
            "description": "Longest silence: until the answer starts, and between chunks of it"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "What its offers are by default; calls go by the offers' own"
          }
        },
        "required": ["id"]
      }
    },
    "ai_model": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "name": {
            "type": "string",
            "maxLength": 191,
            "x-index": "unique"
          },
          "context_length": {
            "type": "integer",
            "description": "Context window in tokens; a longer request skips the model"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "What its offers are by default; calls go by the offers' own"
          }
        },
        "required": ["id"]
      }
    },
    "ai_model_capability": {
      "additionalProperties": {
        "properties": {
          "model_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "ai_model",
            "x-qg-on-parent-delete": "cascade"
          },
          "capability": {
            "type": "string",
            "maxLength": 32,
            "x-index": "primary"
          }
        },
        "required": ["model_id", "capability"]
      }
    },
    "ai_model_provider": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "model_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "ai_model",
            "x-qg-on-parent-delete": "cascade"
          },
          "provider_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "ai_provider",
            "x-qg-on-parent-delete": "cascade"
          },
          "provider_model": {
            "type": "string",
            "maxLength": 191,
            "description": "The model's name at this provider, if it differs"
          },
          "cost_input": {
            "type": "number",
            "description": "Input price per million provider-reported units"
          },
          "cost_output": {
            "type": "number",
            "description": "Output price per million provider-reported units"
          },
          "speed": {
            "type": "number",
            "description": "Units per second, higher first with prefer: speed"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        },
        "required": ["id"]
      }
    },
    "ai_model_score": {
      "additionalProperties": {
        "properties": {
          "model_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "ai_model",
            "x-qg-on-parent-delete": "cascade"
          },
          "metric": {
            "type": "string",
            "maxLength": 64,
            "x-index": "primary",
            "description": "intelligence, coding, math \u2026 \u2014 the names `prefer` weighs; higher is better"
          },
          "value": {
            "type": "number"
          }
        },
        "required": ["model_id", "metric"]
      }
    }
  }
}
