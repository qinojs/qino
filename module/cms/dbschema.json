{
  "properties": {
    "page": {
      "description": "A node of the CMS tree: a page (type p) or a content block on it (type c), under its parent (basis), rendered by its module",
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "log_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "log"
          },
          "log_id_ch": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "log"
          },
          "type": {
            "type": "string",
            "maxLength": 1,
            "x-index": true
          },
          "basis": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "page"
          },
          "sort": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767,
            "default": 0,
            "x-index": true
          },
          "module": {
            "type": "string",
            "maxLength": 127,
            "x-index": true,
            "x-qg-parent": "module",
            "x-qg-on-parent-delete": ""
          },
          "access": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127,
            "x-index": true
          },
          "online_start": {
            "type": "integer",
            "x-index": true
          },
          "online_end": {
            "type": "integer",
            "x-index": true
          },
          "visible": {
            "type": "boolean"
          },
          "searchable": {
            "type": "boolean",
            "x-index": true
          },
          "title_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "text",
            "x-qg-on-parent-delete": "setnull"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "x-index": true
          },
          "settings": {
            "type": "string"
          }
        },
        "required": ["id", "type", "basis", "sort", "module", "visible", "searchable"]
      }
    },
    "page_access_grp": {
      "description": "Access to a node for a group",
      "additionalProperties": {
        "properties": {
          "page_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "page",
            "x-qg-on-parent-delete": "cascade",
            "x-qg-on-parent-copy": "cascade"
          },
          "grp_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "grp",
            "x-qg-on-parent-delete": "cascade",
            "x-qg-on-parent-copy": "cascade"
          },
          "access": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127
          }
        },
        "required": ["page_id", "grp_id", "access"]
      }
    },
    "page_access_usr": {
      "description": "Access to a node for a user",
      "additionalProperties": {
        "properties": {
          "page_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "page",
            "x-qg-on-parent-delete": "cascade",
            "x-qg-on-parent-copy": "cascade"
          },
          "usr_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "usr",
            "x-qg-on-parent-delete": "cascade",
            "x-qg-on-parent-copy": "cascade"
          },
          "access": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127
          }
        },
        "required": ["page_id", "usr_id", "access"]
      }
    },
    "page_file": {
      "description": "The named files of a node",
      "additionalProperties": {
        "properties": {
          "page_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "page",
            "x-qg-on-parent-delete": "cascade"
          },
          "name": {
            "type": "string",
            "maxLength": 191,
            "x-index": "primary"
          },
          "file_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "file",
            "x-qg-on-parent-delete": "cascade"
          },
          "sort": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767,
            "default": 0,
            "x-index": true
          }
        },
        "required": ["page_id", "name", "file_id", "sort"]
      }
    },
    "node_changed": {
      "description": "One row per change of a node's content, with the request that made it",
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "integer",
            "x-index": "primary",
            "x-autoincrement": true
          },
          "log_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "log"
          },
          "node_id": {
            "type": "integer",
            "x-index": true
          },
          "page_id": {
            "type": "integer",
            "x-index": true
          },
          "data": {
            "type": "string"
          }
        },
        "required": ["id", "node_id", "page_id"]
      }
    },
    "page_redirect": {
      "description": "Old URLs that redirect to a page",
      "additionalProperties": {
        "properties": {
          "request": {
            "type": "string",
            "maxLength": 191,
            "x-index": "primary"
          },
          "redirect": {
            "type": "string"
          }
        },
        "required": ["request", "redirect"]
      }
    },
    "page_text": {
      "description": "The named texts of a node",
      "additionalProperties": {
        "properties": {
          "page_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "page",
            "x-qg-on-parent-delete": "cascade"
          },
          "name": {
            "type": "string",
            "maxLength": 128,
            "x-index": "primary"
          },
          "text_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "text",
            "x-qg-on-parent-delete": "cascade"
          }
        },
        "required": ["page_id", "name", "text_id"]
      }
    },
    "page_url": {
      "description": "The URL of a page, per language",
      "additionalProperties": {
        "properties": {
          "page_id": {
            "type": "integer",
            "x-index": "primary",
            "x-qg-parent": "page",
            "x-qg-on-parent-delete": "cascade"
          },
          "lang": {
            "type": "string",
            "maxLength": 12,
            "x-index": "primary"
          },
          "url": {
            "type": "string",
            "maxLength": 255,
            "x-index": true
          },
          "custom": {
            "type": "boolean",
            "default": false
          },
          "target": {
            "type": "string"
          }
        },
        "required": ["page_id", "lang", "url", "custom"]
      }
    },
    "grp": {
      "additionalProperties": {
        "properties": {
          "cms_access": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "x-index": true
          }
        }
      }
    },
    "module": {
      "additionalProperties": {
        "properties": {
          "cms_access": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": ["name"]
      }
    }
  }
}
