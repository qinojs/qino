{
  "properties": {
    "fin_hosting_domain": {
      "description": "A customer's domain: what their hosting, domain and service subscriptions are for",
      "additionalProperties": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 191,
            "x-index": "primary",
            "description": "The domain, lower case: example.ch"
          },
          "usr_id": {
            "type": "integer",
            "x-index": true,
            "x-qg-parent": "usr",
            "x-qg-on-parent-delete": "setnull",
            "description": "Whose it is; without one it is ours or nobody's yet"
          },
          "alias_of": {
            "type": "string",
            "maxLength": 191,
            "x-index": true,
            "x-qg-parent": "fin_hosting_domain",
            "x-qg-parent-field": "name",
            "x-qg-on-parent-delete": "setnull",
            "description": "The domain it is an alias of: served by its hosting, its customer's"
          },
          "registrar": {
            "type": "string",
            "maxLength": 100,
            "description": "Where we registered it — then it is billed, unless free. Empty: the customer keeps it elsewhere"
          },
          "expires": {
            "type": "string",
            "format": "date",
            "description": "When its registration ends, as the registrar says"
          },
          "free": {
            "type": "boolean",
            "default": false,
            "description": "Nothing is billed for it: ours, or given"
          },
          "created": {
            "type": "integer"
          },
          "changed": {
            "type": "integer"
          }
        },
        "required": ["name", "created", "changed"]
      }
    }
  }
}
